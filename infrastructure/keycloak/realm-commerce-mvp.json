{
  "realm": "commerce-mvp",
  "enabled": true,
  "displayName": "Commerce MVP",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "sslRequired": "external",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@commerce.local",
    "fromDisplayName": "Commerce MVP"
  },
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Customer shopping role"
      },
      {
        "name": "ADMIN",
        "description": "Administrator catalog role"
      }
    ]
  },
  "clients": [
    {
      "clientId": "commerce-backend",
      "name": "Commerce Backend Resource APIs",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "commerce-web",
      "name": "Future Angular Frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": false,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid email profile",
        "useJwksUrl": "true"
      }
    }
  ],
  "users": [
    {
      "username": "admin@example.test",
      "email": "admin@example.test",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin-local-pass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ]
    },
    {
      "username": "customer@example.test",
      "email": "customer@example.test",
      "firstName": "Customer",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "customer-local-pass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "CUSTOMER"
      ]
    }
  ]
}
